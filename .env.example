# ==========================================
# OJT Java12 - Project Knowledge Base Environment
# ==========================================

# Database (PostgreSQL)
POSTGRES_DB=ojt_knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Security / JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Storage Mode: 'local' (recommended, skips MinIO completely) or 'minio'
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads

# MinIO (Only required if STORAGE_TYPE=minio)
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ojt-documents

# Default Seeded Admin Account
ADMIN_EMAIL=admin@ojt.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator

# File Upload Limit (Bytes) - Default 50MB
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# Frontend API Base URL (if building standalone)
VITE_API_BASE_URL=/api
